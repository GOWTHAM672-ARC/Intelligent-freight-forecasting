# Frontend Environment Variables Template
# Copy to .env or set in your deployment dashboard (e.g. Vercel, Netlify, Render)

# Base URL pointing to the FastAPI backend
# - For local development: http://127.0.0.1:8000
# - For unified container / reverse proxy (same domain): leave empty or /api
# - For decoupled deployment (e.g., Vercel + Render): https://your-backend-url.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
