# Backend Environment Variables Template
# Copy to .env or set in your hosting platform (Render, Railway, Fly.io, Heroku)

# Server port & host
PORT=8000
HOST=0.0.0.0
RELOAD=false

# Allowed CORS origins (comma-separated, e.g.: https://your-app.vercel.app,http://localhost:5173 or * for wildcard)
CORS_ORIGINS=*

# Optional directory to pre-built React frontend dist (used for single-container fullstack deployment)
# FRONTEND_DIST=../frontend/dist
