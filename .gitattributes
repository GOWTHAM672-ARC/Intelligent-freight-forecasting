# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.css text
*.html text
*.md text
*.py text
*.yml text
*.yaml text
*.toml text
*.dockerignore text
*.gitignore text

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must retain LF
*.sh text eol=lf
